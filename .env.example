# Copy this file to .env and fill in a key to use LIVE mode (run_live.py).
# The committed samples + demo + tests run WITHOUT any key.
# .env is gitignored — never commit real secrets.

# which provider the LLM layer uses (anthropic | openai)
LLM_PROVIDER=anthropic

# set the key for whichever provider you chose:
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# optional: override the model
# LLM_MODEL=claude-haiku-4-5
